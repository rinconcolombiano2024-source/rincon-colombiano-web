# ============================================================
# RINCÓN COLOMBIANO WEB
# Variables de entorno
#
# IMPORTANTE:
# - Este archivo SÍ se guarda en GitHub.
# - Nunca poner secretos reales aquí.
# - Los valores reales irán en .env.local y en Vercel.
# ============================================================


# ============================================================
# APLICACIÓN
# ============================================================

NODE_ENV=development

NEXT_PUBLIC_APP_NAME="Rincón Colombiano"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dominio final:
# NEXT_PUBLIC_SITE_URL=https://rinconcolombiano.pl

NEXT_PUBLIC_BRAND_NAME="Rincón Colombiano"
NEXT_PUBLIC_DEFAULT_LOCALE=pl

# Idiomas disponibles:
NEXT_PUBLIC_SUPPORTED_LOCALES=pl,es,en


# ============================================================
# ENTORNO / RELEASE
# ============================================================

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0

# Valores esperados:
# development
# preview
# production


# ============================================================
# SUPABASE
# ============================================================

# Variables públicas permitidas en navegador.
# No contienen privilegios administrativos.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# SOLO SERVIDOR
# ------------------------------------------------------------
# JAMÁS utilizar NEXT_PUBLIC_ con esta clave.
# JAMÁS enviarla al navegador.

SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# RC ORDERA
# ============================================================

# ------------------------------------------------------------
# APLICACIÓN PÚBLICA RC ORDERA
# ------------------------------------------------------------

# URL pública de RC ORDERA utilizada también desde el servidor.
RC_ORDERA_PUBLIC_APP_URL=https://rincon-colombiano-pedidosapp.vercel.app


# ------------------------------------------------------------
# CONEXIÓN PÚBLICA RC ORDERA / SUPABASE
# ------------------------------------------------------------

# Proyecto Supabase utilizado por RC ORDERA.
#
# IMPORTANTE:
# - utilizar solamente la clave anon/public;
# - nunca utilizar service_role aquí;
# - estas variables son consumidas solamente por el servidor web.

RC_ORDERA_SUPABASE_URL=
RC_ORDERA_SUPABASE_ANON_KEY=


# ------------------------------------------------------------
# CONFIGURACIÓN DE INTEGRACIÓN
# ------------------------------------------------------------

# Timeout máximo de lectura desde RC ORDERA, en milisegundos.
RC_ORDERA_API_TIMEOUT_MS=8000

# ============================================================
# RESTAURANTE / MULTI-SEDE
# ============================================================

# Sede principal por defecto.
DEFAULT_LOCATION_SLUG=czapelska

# Identificadores estables.
# Los IDs reales vendrán posteriormente de RC ORDERA/Supabase.

CZAPELSKA_LOCATION_ID=
BRZESKA_LOCATION_ID=


# ============================================================
# PEDIDOS
# ============================================================

NEXT_PUBLIC_ORDERS_ENABLED=true
NEXT_PUBLIC_PICKUP_ENABLED=true
NEXT_PUBLIC_DELIVERY_ENABLED=true

# URL pública para pedido si temporalmente RC ORDERA
# continúa operando en otro dominio.
NEXT_PUBLIC_ORDER_APP_URL=https://rincon-colombiano-pedidosapp.vercel.app


# ============================================================
# DELIVERY
# ============================================================

# Activación global
DELIVERY_ENABLED=true

# Unidad utilizada internamente
DELIVERY_DISTANCE_UNIT=km

# Área general de servicio.
# La disponibilidad definitiva se valida en RC ORDERA.
DELIVERY_SERVICE_AREA=warsaw

# Modelo de precio de entrega.
# El costo se calcula según la distancia entre el restaurante
# y la dirección de entrega.
DELIVERY_PRICING_MODE=distance

# ============================================================
# RESERVAS
# ============================================================

NEXT_PUBLIC_RESERVATIONS_ENABLED=false

# Integración futura
RESERVATIONS_PROVIDER=internal

RESERVATIONS_API_URL=
RESERVATIONS_API_KEY=


# ============================================================
# CATERING
# ============================================================

NEXT_PUBLIC_CATERING_ENABLED=true

CATERING_EMAIL=
CATERING_PHONE=


# ============================================================
# GOOGLE MAPS / GEOLOCALIZACIÓN
# ============================================================

# Clave visible en navegador.
# Debe restringirse en Google Cloud por dominio y API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Si en el futuro usamos servicios sensibles desde backend.
GOOGLE_MAPS_SERVER_API_KEY=


# ============================================================
# GOOGLE / SEO
# ============================================================

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=

NEXT_PUBLIC_GOOGLE_MAPS_CZAPELSKA_URL=
NEXT_PUBLIC_GOOGLE_MAPS_BRZESKA_URL=


# ============================================================
# ANALYTICS
# ============================================================

NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=


# ============================================================
# MONITORIZACIÓN / SENTRY
# ============================================================

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

SENTRY_ORG=
SENTRY_PROJECT=

SENTRY_ENVIRONMENT=development


# ============================================================
# CORREO TRANSACCIONAL
# ============================================================

EMAIL_PROVIDER=resend

# SOLO SERVIDOR
RESEND_API_KEY=

EMAIL_FROM="Rincón Colombiano <no-reply@rinconcolombiano.pl>"

CONTACT_EMAIL=
ORDERS_EMAIL=
CATERING_EMAIL_RECIPIENT=


# ============================================================
# CONTACTO
# ============================================================

NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=


# ============================================================
# REDES SOCIALES
# ============================================================

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=


# ============================================================
# SEGURIDAD
# ============================================================

# Secretos utilizados en backend.
# Crear valores largos y aleatorios para producción.

INTERNAL_API_SECRET=
WEBHOOK_SECRET=

# Protección futura contra abuso/rate limiting.
RATE_LIMIT_ENABLED=true


# ============================================================
# CAPTCHA / ANTISPAM
# ============================================================

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ============================================================
# PAGOS
# ============================================================

# Desactivado inicialmente.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

PAYMENT_PROVIDER=

PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=


# ============================================================
# FUNCIONES DE PRODUCTO
# ============================================================

NEXT_PUBLIC_FEATURE_MENU=true
NEXT_PUBLIC_FEATURE_ONLINE_ORDERING=true
NEXT_PUBLIC_FEATURE_DELIVERY=true
NEXT_PUBLIC_FEATURE_PICKUP=true
NEXT_PUBLIC_FEATURE_RESERVATIONS=false
NEXT_PUBLIC_FEATURE_CATERING=true
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_LOCATIONS=true
NEXT_PUBLIC_FEATURE_PROMOTIONS=true


# ============================================================
# CACHE
# ============================================================

# Tiempo de caché del menú en segundos.
MENU_CACHE_TTL=300

# Información de sedes.
LOCATIONS_CACHE_TTL=600


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info

# Valores:
# debug
# info
# warn
# error


# ============================================================
# DESARROLLO
# ============================================================

DEBUG=false
